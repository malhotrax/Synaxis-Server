// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model users {
  id String @id @default(uuid())
  username String @unique
  email String @unique
  hashedPassword String @map("hashed_password")
  fullName String? @map("full_name")
  avatarUrl String? @map("avatar_url")
  refreshToken String? @map("refresh_token")
  createdAt DateTime @default(now())  @map("created_at")
  chats chats[] @relation("chat_members")
  sendMessages messages[] 
  sentRequests friend_requests[] @relation("SentRequests")
  receivedRequests friend_requests[] @relation("ReceivedRequests") 
  blockedBy block_request[] @relation("BlockedRequests")
  blocking block_request[] @relation("BlockerRequests")

  friendshipA friendships[] @relation("FriendshipA")
  friendshipB friendships[] @relation("FriendshipB")
}

model chats {
  id String @id @default(uuid())
  name String? 
  lastMessage String? @map("last_message")
  lastActivity DateTime? @map("last_activity")
  createdAt DateTime @default(now()) @map("created_at")
  members users[] @relation("chat_members")
  messages messages[]
}

model messages {
  id String @id @default(uuid())
  text String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  senderId String @map("sender_id")
  chatId String @map("chat_id")
  status MessageStatus @default(SENT)
  

  sender users @relation(fields: [senderId], references: [id], onDelete: Cascade)
  chat chats @relation(fields: [chatId], references: [id], onDelete: Cascade)
   @@index([chatId, createdAt(sort: Desc)])
}

model friend_requests {
  id String @id @default(uuid())
  senderId  String @map("sender_id")
  receiverId String @map("receiver_id")
  status FriendRequestStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")

  sender users @relation(name: "SentRequests",fields: [senderId], references: [id] , onDelete: Cascade)
  receiver users @relation(name: "ReceivedRequests",fields: [receiverId], references: [id], onDelete: Cascade)
  @@unique([senderId,receiverId])

}

model friendships {
  id String @id @default(uuid())
  userAId String  @map("user_a_id")
  userBId String @map("user_b_id")
  createdAt DateTime @default(now()) @map("created_at")
  userA users @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB users @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId,userBId])
  @@index([userAId])
  @@index([userBId])
}

model block_request {
  id String @id @default(uuid())
  blockerId String @map("blocker_id")
  blockedId String @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocker users @relation("BlockerRequests",fields: [blockerId], references: [id], onDelete: Cascade)
  blocked users @relation("BlockedRequests",fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockedId,blockerId])
}
enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum FriendRequestStatus {
  PENDING
  REJECTED
}
